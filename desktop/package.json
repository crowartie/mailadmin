{
  "name": "pochta-desktop",
  "productName": "Почта",
  "version": "1.0.0",
  "description": "Почта для Windows: веб-почта в отдельном окне, значок в трее, уведомления, mailto:, автообновление",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "mailadmin",
  "defaultServer": "",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "e2e": "playwright test --config test/e2e/playwright.config.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ru.mailadmin.pochta",
    "productName": "Почта",
    "artifactName": "Pochta-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "executableName": "Pochta"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Почта",
      "uninstallDisplayName": "Почта",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "protocols": [{ "name": "Почта", "schemes": ["mailto"] }],
    "publish": [{ "provider": "generic", "url": "https://example.invalid/app/windows" }]
  }
}
