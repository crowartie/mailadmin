#!/usr/bin/env bash
# Единственная команда, которую веб-приложение (www-data) может запускать через sudo.
# Каждое действие — отдельная подкоманда с проверкой аргументов: никаких произвольных команд.
set -euo pipefail
export LC_ALL=C.UTF-8

die() { echo "mailadmin-ctl: $*" >&2; exit 2; }
qid() { [[ "$1" =~ ^[A-Za-z0-9]{6,20}$ ]] || die "bad queue id: $1"; }
ipv() { [[ "$1" =~ ^[0-9a-fA-F:.]{3,45}$ ]] || die "bad ip: $1"; }
mailaddr() { [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]] || die "bad address: $1"; }
word() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "bad name: $1"; }
num() { [[ "$1" =~ ^[0-9]{1,12}$ ]] || die "bad number: $1"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  # ── очередь Postfix ────────────────────────────────────────────
  queue-json)     exec postqueue -j ;;
  queue-cat)      qid "$1"; exec postcat -q "$1" ;;
  queue-headers)  qid "$1"; exec postcat -qh "$1" ;;
  queue-flush)    exec postqueue -f ;;
  queue-retry)    for id in "$@"; do qid "$id"; postqueue -i "$id"; done ;;
  queue-hold)     for id in "$@"; do qid "$id"; done; exec postsuper -h "$@" ;;
  queue-release)  for id in "$@"; do qid "$id"; done; exec postsuper -H "$@" ;;
  queue-delete)   for id in "$@"; do qid "$id"; done; exec postsuper -d "$@" ;;
  # ── журналы ─────────────────────────────────────────────────────
  log-tail)       num "$1"; exec tail -n "$1" /var/log/mail.log ;;
  log-grep)       [[ ${#1} -ge 3 && ${#1} -le 200 ]] || die "bad pattern"; exec grep -h -F -- "$1" /var/log/mail.log.1 /var/log/mail.log 2>/dev/null || true ;;
  log-since)      re='^[0-9T:+.-]{10,40}$'; [[ "$1" =~ $re ]] || die "bad time"; awk -v t="$1" '$1 >= t' /var/log/mail.log ;;
  # ── fail2ban ───────────────────────────────────────────────────
  f2b-status)     exec fail2ban-client status ;;
  f2b-config)     num "$1"; num "$2"; num "$3"; exec /usr/local/sbin/mailadmin-f2b "$1" "$2" "$3" ;;
  f2b-jail)       word "$1"; exec fail2ban-client status "$1" ;;
  f2b-banned)     exec fail2ban-client banned ;;
  f2b-unban)      ipv "$1"; exec fail2ban-client unban "$1" ;;
  f2b-ban)        word "$1"; ipv "$2"; exec fail2ban-client set "$1" banip "$2" ;;
  f2b-ignore)     ipv "$1"; for j in $(fail2ban-client status | sed -n 's/.*Jail list:\s*//p' | tr ',' ' '); do fail2ban-client set "$j" addignoreip "$1" >/dev/null; done; echo ok ;;
  # ── Dovecot ────────────────────────────────────────────────────
  who)            exec doveadm who ;;
  # Общий доступ к папкам: doveadm acl. Имя папки — UTF-8, без управляющих символов.
  acl-get)        mailaddr "$1"; re='^[^[:cntrl:]]{1,200}$'; [[ "$2" =~ $re ]] || die "bad folder"; exec doveadm acl get -u "$1" "$2" ;;
  acl-set)        mailaddr "$1"; re='^[^[:cntrl:]]{1,200}$'; [[ "$2" =~ $re ]] || die "bad folder"; mailaddr "$3"; o="$1"; f="$2"; w="$3"; shift 3
                  rr='^(lookup|read|write|write-seen|write-deleted|insert|post|expunge|create|delete)$'; for r in "$@"; do [[ "$r" =~ $rr ]] || die "bad right"; done
                  exec doveadm acl set -u "$o" "$f" "user=$w" "$@" ;;
  acl-delete)     mailaddr "$1"; re='^[^[:cntrl:]]{1,200}$'; [[ "$2" =~ $re ]] || die "bad folder"; mailaddr "$3"; exec doveadm acl delete -u "$1" "$2" "user=$3" ;;
  kick)           mailaddr "$1"; exec doveadm kick "$1" ;;
  sieve-global)   re='^/opt/mailadmin/storage/app/private/sieve/global\.sieve$'; [[ "$1" =~ $re && -f "$1" ]] || die "bad file"
                  install -o vmail -g vmail -m 0440 "$1" /var/vmail/sieve/mailadmin-global.sieve
                  sievec /var/vmail/sieve/mailadmin-global.sieve 2>&1 || die "sievec failed"; chown vmail:vmail /var/vmail/sieve/mailadmin-global.svbin 2>/dev/null; echo ok ;;
  # ── службы ─────────────────────────────────────────────────────
  service-restart) case "$1" in postfix|dovecot|amavis|nginx|fail2ban|iredapd|mlmmjadmin|clamav-daemon|clamav-freshclam) exec systemctl restart "$1";; *) die "bad service";; esac ;;
  service-reload)  case "$1" in postfix|dovecot|amavis|nginx|fail2ban) exec systemctl reload "$1";; *) die "bad service";; esac ;;
  service-enable)  case "$1" in clamav-daemon|clamav-freshclam) exec systemctl enable --now "$1";; *) die "bad service";; esac ;;
  service-disable) case "$1" in clamav-daemon|clamav-freshclam) exec systemctl disable --now "$1";; *) die "bad service";; esac ;;
  # ── Postfix / Amavis настройки ─────────────────────────────────
  postconf-get)   word "$1"; exec postconf -h "$1" ;;
  postconf-set)   word "$1"; re='^[A-Za-z0-9,._:/@ -]{1,200}$'; [[ "$2" =~ $re ]] || die "bad value"; postconf -e "$1=$2"; systemctl reload postfix; echo ok ;;
  amavis-get)     word "$1"; grep -E "^\\\$$1\s*=" /etc/amavis/conf.d/50-user | tail -1 ;;
  amavis-set)     word "$1"; [[ "$2" =~ ^[0-9.]{1,6}$ ]] || die "bad value"
                  sed -i -E "s/^(\\\$$1\s*=\s*)[0-9.]+;/\1$2;/" /etc/amavis/conf.d/50-user; echo ok ;;
  # Перезапуск отдельно: несколько правок подряд — один рестарт (иначе systemd упирается в start-limit).
  amavis-apply)   systemctl reset-failed amavis 2>/dev/null; systemctl restart amavis; sleep 1; systemctl is-active amavis ;;
  amavis-virus)   case "$1" in on) sed -i -E 's/^@bypass_virus_checks_maps = \(1\);/#@bypass_virus_checks_maps = (1);/' /etc/amavis/conf.d/50-user;;
                                off) grep -q '^@bypass_virus_checks_maps = (1);' /etc/amavis/conf.d/50-user || sed -i '1a @bypass_virus_checks_maps = (1);' /etc/amavis/conf.d/50-user;; *) die "on|off";; esac
                  echo ok ;;
  amavis-release) re='^[A-Za-z0-9_+-]{8,24}$'; [[ "$1" =~ $re && "$2" =~ $re ]] || die "bad ids"; exec amavisd-release "$1" "$2" ;;
  iredapd-plugins) exec grep -E '^plugins' /opt/iredapd/settings.py ;;
  iredapd-greylist) case "$1" in on) sed -i -E 's/^(plugins = \[.*)"throttle"/\1"greylisting", "throttle"/' /opt/iredapd/settings.py; sed -i -E 's/"greylisting", "greylisting", /"greylisting", /' /opt/iredapd/settings.py;;
                                  off) sed -i -E 's/"greylisting", //' /opt/iredapd/settings.py;; *) die "on|off";; esac
                  systemctl restart iredapd; echo ok ;;
  # ── DKIM и сертификат ──────────────────────────────────────────
  dkim-txt)       re='^[a-z0-9.-]+$'; [[ "$1" =~ $re ]] || die "bad domain"; f="/var/lib/dkim/$1.pem"; [ -f "$f" ] || die "no key"
                  pub=$(openssl rsa -in "$f" -pubout 2>/dev/null | grep -v -- '-----' | tr -d '\n'); echo "v=DKIM1; k=rsa; p=$pub" ;;
  dkim-info)      re='^[a-z0-9.-]+$'; [[ "$1" =~ $re ]] || die "bad domain"; f="/var/lib/dkim/$1.pem"; [ -f "$f" ] || die "no key"
                  echo "bits=$(openssl rsa -in "$f" -text -noout 2>/dev/null | sed -n 's/.*Private-Key: (\([0-9]*\) bit.*/\1/p')"; echo "mtime=$(stat -c %Y "$f")" ;;
  dkim-rotate)    re='^[a-z0-9.-]+$'; [[ "$1" =~ $re ]] || die "bad domain"; f="/var/lib/dkim/$1.pem"; cp -a "$f" "$f.$(date +%Y%m%d%H%M%S).bak"
                  openssl genrsa -out "$f" 2048 2>/dev/null; chown amavis:amavis "$f"; chmod 0400 "$f"; systemctl restart amavis; echo ok ;;
  cert-info)      exec openssl x509 -in /etc/ssl/certs/iRedMail.crt -noout -subject -issuer -dates -ext subjectAltName ;;
  cert-renew)     certbot renew --no-random-sleep-on-renew 2>&1 | tail -20; systemctl reload nginx postfix dovecot; echo "rc=$?" ;;
  cert-log)       exec tail -n 40 /var/log/letsencrypt/letsencrypt.log ;;
  # Добавить имя (например mta-sts.домен) в сертификат Let's Encrypt и в server_name веб-почты.
  cert-expand)    re='^[a-z0-9.-]+$'; [[ "$1" =~ $re ]] || die "bad name"; n="$1"
                  cn=$(certbot certificates 2>/dev/null | awk '/Certificate Name:/{print $3; exit}'); [ -n "$cn" ] || die "no certbot certificate"
                  cur=$(certbot certificates 2>/dev/null | awk '/Domains:/{ $1=""; print; exit}')
                  args=""; for d in $cur; do args="$args -d $d"; done; echo "$cur" | grep -qw "$n" || args="$args -d $n"
                  grep -q "$n" /etc/nginx/sites-enabled/mailweb.conf || sed -i -E "s/^(\s*server_name\s+)(.*);/\1\2 $n;/" /etc/nginx/sites-enabled/mailweb.conf
                  nginx -t >/dev/null 2>&1 && systemctl reload nginx
                  certbot certonly --non-interactive --webroot -w /opt/www/well_known --cert-name "$cn" --expand $args 2>&1 | tail -3
                  systemctl reload nginx postfix dovecot; echo "rc=$?" ;;
  # ── резервные копии ────────────────────────────────────────────
  backup-run)     exec /usr/local/sbin/mailadmin-backup "$@" ;;
  backup-list)    d="${1:-/var/backups/mail}"; re='^/[A-Za-z0-9/_.-]+$'; [[ "$d" =~ $re ]] || die "bad dir"; ls -1 --time-style=+%s -l "$d" 2>/dev/null | awk '{print $6, $5, $7}' ;;
  backup-restore-mailbox) re='^/[A-Za-z0-9/_.-]+\.tar\.gz$'; [[ "$1" =~ $re ]] || die "bad archive"; mailaddr "$2"; exec /usr/local/sbin/mailadmin-backup restore-mailbox "$1" "$2" ;;
  disk)           exec df -B1 --output=size,used,avail,target /var/vmail / ;;
  # ── рассылки mlmmj ─────────────────────────────────────────────
  mlmmj-mod-list) mailaddr "$1"; d="/var/vmail/mlmmj/${1#*@}/${1%@*}/moderation"; [ -d "$d" ] || { echo; exit 0; }
                  for f in "$d"/*; do [ -f "$f" ] || continue; [[ "$f" == *.sending ]] && continue
                    fr=$(grep -i -m1 '^From:' "$f" | cut -d: -f2- | sed 's/^ *//'); su=$(grep -i -m1 '^Subject:' "$f" | cut -d: -f2- | sed 's/^ *//')
                    printf '%s\t%s\t%s\t%s\n' "$(basename "$f")" "$fr" "$su" "$(stat -c %Y "$f")"; done ;;
  mlmmj-mod-approve) mailaddr "$1"; word "$2"; d="/var/vmail/mlmmj/${1#*@}/${1%@*}"; f="$d/moderation/$2"; [ -f "$f" ] || die "no message"
                  /usr/bin/mlmmj-send -L "$d" -m "$f" && rm -f "$f"; echo ok ;;
  mlmmj-mod-reject)  mailaddr "$1"; word "$2"; d="/var/vmail/mlmmj/${1#*@}/${1%@*}"; rm -f "$d/moderation/$2"; echo ok ;;
  mlmmj-archive)  mailaddr "$1"; d="/var/vmail/mlmmj-archive/${1#*@}/${1%@*}"; [ -d "$d" ] || { echo; exit 0; }
                  for n in $(ls -1t "$d" | head -50); do f="$d/$n"; [ -f "$f" ] || continue
                    fr=$(grep -i -m1 '^From:' "$f" | cut -d: -f2- | sed 's/^ *//'); su=$(grep -i -m1 '^Subject:' "$f" | cut -d: -f2- | sed 's/^ *//')
                    printf '%s\t%s\t%s\t%s\n' "$n" "$fr" "$su" "$(stat -c %Y "$f")"; done ;;
  # Штатный инструмент iRedMail: создаёт рассылку в mlmmj и в таблице vmail.maillists.
  mlmmj-admin)    act="$1"; shift; case "$act" in create|info|update|delete|subscribers|add_subscribers|remove_subscribers|has_subscriber) ;; *) die "bad action";; esac
                  mailaddr "$1"; addr="$1"; shift; re='^([a-z_]+=[^;&|`$]{0,300}|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+)$'
                  for a in "$@"; do [[ "$a" =~ $re ]] || die "bad arg: $a"; done
                  cd /opt/mlmmjadmin/tools && exec python3 maillist_admin.py "$act" "$addr" "$@" ;;
  # ── ящики ──────────────────────────────────────────────────────
  maildir-size)   re='^/var/vmail/[A-Za-z0-9/_.@-]+$'; [[ "$1" =~ $re ]] || die "bad path"; du -sb "$1" 2>/dev/null | cut -f1 ;;
  *) die "unknown command: $cmd" ;;
esac
