# /etc/logrotate.d/mailadmin — журналы приложения (auth.log читает fail2ban: copytruncate)
#
# Здесь же /var/log/mail.log: в стандартной настройке Ubuntu он лежит в одной пачке
# с syslog и хранится четыре недели, а журналы Dovecot — десять. Разбор «письмо ушло
# или нет» упирается ровно в это: через месяц половины следов уже не осталось бы.
# update.sh убирает mail.log из /etc/logrotate.d/rsyslog, иначе logrotate ругается
# на две записи об одном файле.
/var/log/mail.log {
    weekly
    rotate 10
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}

/opt/mailadmin/storage/logs/*.log {
    su www-data www-data
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 www-data www-data
}
