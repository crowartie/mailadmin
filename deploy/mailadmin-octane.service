[Unit]
Description=mailadmin — Laravel Octane (RoadRunner) на 127.0.0.1:8000
After=network.target mariadb.service redis-server.service
Wants=mariadb.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/mailadmin
Environment=HOME=/var/www
ExecStart=/usr/bin/php artisan octane:start --server=roadrunner --host=127.0.0.1 --port=8000 --workers=auto --max-requests=500 --rr-config=/opt/mailadmin/.rr.yaml
ExecReload=/usr/bin/php artisan octane:reload --server=roadrunner
Restart=always
RestartSec=3
LimitNOFILE=65535
# octane:start завершает воркеры сам; SIGTERM ему — штатная остановка
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
