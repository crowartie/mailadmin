#!/bin/bash
# Состояние сервера для страницы «Состояние»: JSON, только чтение. Запускается из mailadmin-ctl (root).
set -u
export LC_ALL=C.UTF-8
d=$(date +%F)

read -r l1 l5 l15 _ < /proc/loadavg
cores=$(nproc)
mem=$(free -m | awk 'NR==2{printf "{\"total\":%d,\"used\":%d,\"avail\":%d}", $2, $3, $7}')
swap=$(free -m | awk 'NR==3{printf "{\"total\":%d,\"used\":%d}", $2, $3}')
up=$(cut -d. -f1 /proc/uptime)
indexers=$(pgrep -c indexer-worker || true)
imap=$(doveadm who 2>/dev/null | awk 'NR>1{s+=$2} END{print s+0}')
users=$(doveadm who 2>/dev/null | awk 'NR>1{print $1}' | sort -u | wc -l)
q=$(postqueue -p 2>/dev/null | tail -1 | grep -o '[0-9]* Request' | awk '{print $1}'); q=${q:-0}
reboot=false; [ -e /var/run/reboot-required ] && reboot=true
ntp=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo unknown)
dov_err=$(grep -c "^$d.*\(Error\|Fatal\|Panic\):" /var/log/dovecot/dovecot.log 2>/dev/null || true)
pf_warn=$(grep -c "^$d.*postfix.*warning:" /var/log/mail.log 2>/dev/null || true)
pf_fatal=$(grep -c "^$d.*postfix.*\(fatal\|panic\):" /var/log/mail.log 2>/dev/null || true)
sched=false; grep -qs "schedule:run" /etc/cron.d/* /var/spool/cron/crontabs/* 2>/dev/null && sched=true
salearn_cron=false; [ -f /etc/cron.d/mailadmin-salearn ] && salearn_cron=true
tl=$(systemctl list-timers --all --no-pager 2>/dev/null | grep "mailadmin-index" | head -1)
idx_next=$(echo "$tl" | awk '{print $1" "$2" "$3}')
idx_timer=$(echo "$tl" | grep -o "[A-Z][a-z][a-z] [0-9-]* [0-9:]* [A-Z0-9]*" | sed -n 2p)
upd=$(apt list --upgradable 2>/dev/null | grep -c "upgradable" || true)
sec_upd=$(apt list --upgradable 2>/dev/null | grep -c "\-security" || true)
fail2ban=$(fail2ban-client status 2>/dev/null | grep -c "Jail list" || true)
lastboot=$(who -b 2>/dev/null | awk '{print $3" "$4}')

printf '{"load":[%s,%s,%s],"cores":%d,"mem":%s,"swap":%s,"uptime":%d,"indexers":%d,"imapConnections":%d,"imapUsers":%d,"queue":%d,"rebootRequired":%s,"ntp":"%s","dovecotErrors":%d,"postfixWarnings":%d,"postfixFatal":%d,"schedulerCron":%s,"salearnCron":%s,"indexTimerLast":"%s","indexTimerNext":"%s","updates":%d,"securityUpdates":%d,"fail2ban":%s,"lastBoot":"%s"}\n' \
  "$l1" "$l5" "$l15" "$cores" "$mem" "$swap" "$up" "${indexers:-0}" "${imap:-0}" "${users:-0}" "$q" "$reboot" "$ntp" "${dov_err:-0}" "${pf_warn:-0}" "${pf_fatal:-0}" "$sched" "$salearn_cron" "$idx_timer" "$idx_next" "${upd:-0}" "${sec_upd:-0}" "$([ "${fail2ban:-0}" -gt 0 ] && echo true || echo false)" "$lastboot"
